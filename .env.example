# Copy to .env.local (never commit values). Names only.

# Public base URL used for canonical, sitemap and JSON-LD. Falls back to the Vercel preview URL.
NEXT_PUBLIC_SITE_URL=

# Which booking adapter is active: "embed" (adapter A, default) or "form" (adapter B, stubbed).
BOOKING_ADAPTER=embed

# Adapter A: full URL of the external booking page to embed (Fresha, Booksy, Treatwell, Calendly...).
# Empty = /marcar falls back to WhatsApp and phone.
BOOKING_EMBED_URL=

# Adapter B: Make webhook that will write to Google Calendar and send WhatsApp confirmations.
# Stubbed in this build: the adapter never calls it (see lib/booking/webhook-adapter.ts).
BOOKING_WEBHOOK_URL=
